---
// Cookie-Consent-Banner für Google Ads Conversion-Tracking.
// Lädt gtag.js erst nach explizitem Klick auf "Akzeptieren".
// Entscheidung wird in localStorage gespeichert (wsa_consent).
//
// Hinweis: Sichtbarkeit wird per inline-style="display:..." gesteuert,
// NICHT per Tailwind .hidden — Tailwind v4 purged dynamisch verwendete
// Utility-Klassen aus dem Production-Bundle.
const GTAG_ID = 'AW-18181056795';
const CLARITY_ID = 'x0475iv4fu';
---

<div
  id="wsa-cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-50 bg-cream border-t border-sand"
  style="display: none; box-shadow: 0 -8px 24px rgba(0,0,0,0.06);"
>
  <div class="max-w-5xl mx-auto px-6 md:px-10 py-6 md:py-5 flex flex-col md:flex-row gap-4 md:gap-8 items-start md:items-center">
    <div class="flex-1 text-sm leading-relaxed">
      <p class="serif italic text-base mb-1">Ein kleiner Hinweis</p>
      <p class="text-ink-muted">
        Wir nutzen Google Ads, um zu messen, ob unsere Anzeigen Besucher:innen zum Atelier führen.
        Das setzt einen Cookie und braucht eure Zustimmung — jederzeit widerrufbar.
        <a href="/datenschutz" class="underline hover:text-cognac">Mehr im Datenschutz</a>.
      </p>
    </div>
    <div class="flex gap-3 shrink-0">
      <button
        id="wsa-consent-deny"
        type="button"
        class="text-xs tracking-[0.2em] uppercase text-ink-muted hover:text-ink border-b border-ink-muted hover:border-ink pb-1 transition-colors"
      >
        Ablehnen
      </button>
      <button
        id="wsa-consent-accept"
        type="button"
        class="text-xs tracking-[0.2em] uppercase bg-ink text-paper px-5 py-3 hover:bg-cognac transition-colors"
      >
        Akzeptieren
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ gtagId: GTAG_ID, clarityId: CLARITY_ID }}>
  (function () {
    const STORAGE_KEY = 'wsa_consent';

    // ── Consent-Modus ────────────────────────────────────────────────
    // 'advanced' : Google-Tag lädt IMMER. Ohne Einwilligung werden nur
    //              cookielose Pings (keine Cookies, keine IDs, gclid
    //              redigiert) gesendet — Google MODELLIERT daraus die
    //              fehlenden Conversions. Nötig, weil unsere 65+/mobile
    //              Zielgruppe überdurchschnittlich oft ablehnt und sonst
    //              komplett unsichtbar bliebe. Google-empfohlen, EEA-tauglich.
    // 'basic'    : konservativer — Tag lädt erst nach „Akzeptieren",
    //              vor der Einwilligung passiert gar nichts (= keine
    //              Modellierung, dafür kein Tag-Load vor Consent).
    // Umschalten = nur dieser eine String.
    const CONSENT_MODE = 'advanced';

    const banner = document.getElementById('wsa-cookie-banner');
    const acceptBtn = document.getElementById('wsa-consent-accept');
    const denyBtn = document.getElementById('wsa-consent-deny');

    // Tracking nur auf der Produktions-Domain laden. Verhindert, dass lokale
    // Tests (localhost) oder Preview-Deploys (*.pages.dev) echte Conversions
    // und Clarity-Sitzungen auslösen und die Analytics verfälschen.
    const PROD_HOSTS = ['weddingstoryatelier.de', 'www.weddingstoryatelier.de'];
    if (!PROD_HOSTS.includes(location.hostname)) {
      if (banner) banner.style.display = 'none';
      return;
    }

    function showBanner() {
      if (banner) banner.style.display = 'block';
    }
    function hideBanner() {
      if (banner) banner.style.display = 'none';
    }

    // gtag-Stub sofort bereitstellen, damit consent-Befehle vor dem
    // Script-Load in die dataLayer-Queue laufen.
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = gtag;

    const GRANTED = {
      ad_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted',
      analytics_storage: 'granted',
    };

    function loadGtag() {
      if (window.wsaGtagLoaded) return;
      window.wsaGtagLoaded = true;

      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gtagId;
      document.head.appendChild(s);

      gtag('js', new Date());
      gtag('config', gtagId);

      // Signal an seitenspezifische Conversion-Handler
      window.dispatchEvent(new Event('wsa:ads-ready'));
    }

    function loadClarity() {
      // Clarity (Session-Recording) bleibt STRENG einwilligungspflichtig —
      // wird nie ohne „Akzeptieren" geladen.
      if (window.wsaClarityLoaded || !clarityId) return;
      window.wsaClarityLoaded = true;
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', clarityId);

      // EEA/UK/CH-Pflicht seit 31.10.2025: Einwilligung aktiv signalisieren.
      window.clarity('consentv2', { ad_Storage: 'granted', analytics_Storage: 'granted' });
    }

    let stored = null;
    try { stored = localStorage.getItem(STORAGE_KEY); } catch (e) {}
    const isGranted = stored === 'granted';

    // 1) Default-Consent: alles abgelehnt — IMMER vor dem Tag-Load setzen.
    gtag('consent', 'default', Object.assign({
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    }, {}));
    // Datenschutz-Härtung: bei fehlender Ad-Einwilligung Klick-IDs redigieren,
    // gclid trotzdem per URL durchreichen (bessere Modellierung ohne Cookies).
    gtag('set', 'ads_data_redaction', true);
    gtag('set', 'url_passthrough', true);

    // 2) Frühere Zustimmung sofort hochstufen.
    if (isGranted) gtag('consent', 'update', GRANTED);

    // 3) Tag laden — im Advanced-Modus immer, im Basic-Modus nur bei Zustimmung.
    if (CONSENT_MODE === 'advanced' || isGranted) loadGtag();
    if (isGranted) loadClarity();

    // 4) Banner nur zeigen, wenn noch keine Entscheidung getroffen wurde.
    if (!stored) showBanner();

    if (acceptBtn) {
      acceptBtn.addEventListener('click', function () {
        try { localStorage.setItem(STORAGE_KEY, 'granted'); } catch (e) {}
        hideBanner();
        gtag('consent', 'update', GRANTED);
        loadGtag();   // Basic-Modus: jetzt erstmals laden. Advanced: no-op (Guard).
        loadClarity();
      });
    }

    if (denyBtn) {
      denyBtn.addEventListener('click', function () {
        try { localStorage.setItem(STORAGE_KEY, 'denied'); } catch (e) {}
        hideBanner();
        // Consent bleibt default-denied. Im Advanced-Modus sendet der bereits
        // geladene Tag weiter cookielose Pings → modellierte Conversions.
      });
    }
  })();
</script>
