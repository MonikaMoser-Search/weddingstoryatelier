---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Navigation, sehr zurückhaltend -->
  <header class="absolute top-0 left-0 right-0 z-10 px-8 py-6 md:px-16">
    <nav class="flex items-center justify-between text-sm tracking-wide">
      <a href="/" class="serif text-xl">Wedding Story Atelier</a>
      <ul class="hidden md:flex gap-10 text-ink-muted">
        <li><a href="/ueber-das-atelier" class="hover:text-ink transition-colors">Über das Atelier</a></li>
        <li><a href="/journal" class="hover:text-ink transition-colors">Journal</a></li>
        <li><a href="/geschenke" class="hover:text-ink transition-colors">Geschenke</a></li>
        <li><a href="/kontakt" class="hover:text-ink transition-colors">Kontakt</a></li>
      </ul>
    </nav>
  </header>

  <!-- Hero — viel Weißraum, editorial -->
  <section class="min-h-screen flex items-center justify-center px-8 md:px-16">
    <div class="max-w-3xl text-center">
      <p class="text-xs tracking-[0.3em] uppercase text-ink-muted mb-8">
        Editorial Atelier
      </p>
      <h1 class="serif text-5xl md:text-7xl lg:text-8xl leading-[1.05] mb-10">
        Eine Hochzeit<br />
        ist eine Geschichte.<br />
        <em class="text-cognac">Wir schreiben sie mit.</em>
      </h1>
      <p class="text-lg md:text-xl text-ink-muted max-w-xl mx-auto leading-relaxed">
        Atelier für editoriale Papeterie und stilbewusste Story-Konzepte.
        Galerie und Werkbank in einem.
      </p>
      <p class="serif italic text-sm text-ink-muted mt-6 tracking-wide">
        Jedes Werk wird im Atelier gedruckt, bevor es zu dir kommt.
      </p>
      <div class="mt-14 flex flex-col sm:flex-row gap-6 items-center justify-center text-sm tracking-wider">
        <a href="#werke" class="border-b border-ink pb-1 hover:border-cognac hover:text-cognac transition-colors">
          Das Atelier betreten →
        </a>
        <a href="/journal" class="text-ink-muted hover:text-ink transition-colors">
          Journal lesen
        </a>
      </div>
    </div>
  </section>

  <!-- Galerie-Teaser -->
  <section id="werke" class="px-8 md:px-16 py-32 bg-cream">
    <div class="max-w-5xl mx-auto">
      <p class="text-xs tracking-[0.3em] uppercase text-ink-muted mb-4">Die Werke</p>
      <h2 class="serif text-4xl md:text-5xl mb-6 max-w-2xl leading-tight">
        Werkzeuge wie Ausstellungsstücke — präzise, ruhig, ganz deine Geschichte.
      </h2>
      <p class="serif italic text-base text-ink-muted mb-16 max-w-xl leading-relaxed">
        Editorial-Charakter entsteht erst auf Papier. Deshalb drucken wir im Atelier mit, während wir entwickeln.
      </p>
      <div class="grid md:grid-cols-3 gap-12">
        <article class="group">
          <div class="aspect-[3/4] mb-5 overflow-hidden bg-sand">
            <img
              src="/images/card-wedding-magazine.png"
              alt="Wedding Magazine — Editorial Hochzeitsmagazin"
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
          <h3 class="serif text-2xl mb-3">Wedding Magazine</h3>
          <p class="text-sm text-ink-muted leading-relaxed mb-5">
            Editorial storytelling für moderne Hochzeiten.
          </p>
          <ul class="text-xs tracking-wide text-ink-muted space-y-1.5 border-t border-sand pt-4">
            <li>· Live im Browser personalisierbar</li>
            <li>· Sofort als PDF exportierbar</li>
            <li>· Druckfertig, ohne Installation</li>
          </ul>
          <div class="mt-5 flex flex-col gap-2.5 items-start">
            <a href="/atelier/wedding-magazine.html" class="text-xs tracking-[0.2em] uppercase border-b border-ink pb-0.5 hover:border-cognac hover:text-cognac transition-colors" target="_blank" rel="noopener">
              Live Preview öffnen
            </a>
            <a href="https://weddingstoryatelier.etsy.com/de/listing/4502599268/hochzeitsmagazin-vorlage-zum" class="text-xs tracking-[0.2em] uppercase text-ink-muted hover:text-cognac transition-colors" target="_blank" rel="noopener">
              Im Atelier-Shop bei Etsy ↗
            </a>
          </div>
        </article>
        <article class="group">
          <div class="aspect-[3/4] mb-5 overflow-hidden bg-sand">
            <img
              src="/images/card-einladungsset.png"
              alt="Einladungsset — Drei-Karten-Konzept"
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
          <h3 class="serif text-2xl mb-3">Einladungsset</h3>
          <p class="text-sm text-ink-muted leading-relaxed mb-5">
            Drei-Karten-Konzept in drei Farbwelten.
          </p>
          <ul class="text-xs tracking-wide text-ink-muted space-y-1.5 border-t border-sand pt-4">
            <li>· Bordeaux · Navy · Salbei</li>
            <li>· DE und US-Formate</li>
            <li>· Vektor-PDF, druckfertig</li>
          </ul>
          <div class="mt-5 flex flex-col gap-2.5 items-start">
            <a href="/atelier/einladungsset.html" class="text-xs tracking-[0.2em] uppercase border-b border-ink pb-0.5 hover:border-cognac hover:text-cognac transition-colors" target="_blank" rel="noopener">
              Live Preview öffnen
            </a>
            <a href="https://weddingstoryatelier.etsy.com/de/listing/4489004903/hochzeit-einladung-set-floral-3-karten" class="text-xs tracking-[0.2em] uppercase text-ink-muted hover:text-cognac transition-colors" target="_blank" rel="noopener">
              Im Atelier-Shop bei Etsy ↗
            </a>
          </div>
        </article>
        <article class="group">
          <div class="aspect-[3/4] mb-5 overflow-hidden bg-sand">
            <img
              src="/images/card-sitzplan.png"
              alt="Sitzplan — gerahmt auf Staffelei"
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
          <h3 class="serif text-2xl mb-3">Sitzplan</h3>
          <p class="text-sm text-ink-muted leading-relaxed mb-5">
            Floral oder Earth — die Bühne für deine Gäste.
          </p>
          <ul class="text-xs tracking-wide text-ink-muted space-y-1.5 border-t border-sand pt-4">
            <li>· Gästeliste live im Browser</li>
            <li>· Foto pro Tisch optional</li>
            <li>· Sofort als PDF exportierbar</li>
          </ul>
          <div class="mt-5 flex flex-col gap-2.5 items-start">
            <a href="/atelier/sitzplan.html" class="text-xs tracking-[0.2em] uppercase border-b border-ink pb-0.5 hover:border-cognac hover:text-cognac transition-colors" target="_blank" rel="noopener">
              Live Preview öffnen
            </a>
            <a href="https://weddingstoryatelier.etsy.com/listing/4485890320" class="text-xs tracking-[0.2em] uppercase text-ink-muted hover:text-cognac transition-colors" target="_blank" rel="noopener">
              Im Atelier-Shop bei Etsy ↗
            </a>
          </div>
        </article>
        <article class="group">
          <div class="aspect-[3/4] mb-5 overflow-hidden bg-sand">
            <img
              src="/images/card-dankeskarte.png"
              alt="Personalisierte Dankeskarte — Old Money Linie"
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
          <h3 class="serif text-2xl mb-3">Dankeskarte</h3>
          <p class="text-sm text-ink-muted leading-relaxed mb-5">
            Jeder Gast mit Namen — dein persönlicher Dank.
          </p>
          <ul class="text-xs tracking-wide text-ink-muted space-y-1.5 border-t border-sand pt-4">
            <li>· Namensanrede aus Gästeliste</li>
            <li>· Drei Old Money Farbwelten</li>
            <li>· A6 + US Letter, druckfertig</li>
          </ul>
          <div class="mt-5 flex flex-col gap-2.5 items-start">
            <a href="/atelier/dankeskarte.html" class="text-xs tracking-[0.2em] uppercase border-b border-ink pb-0.5 hover:border-cognac hover:text-cognac transition-colors" target="_blank" rel="noopener">
              Live Preview öffnen
            </a>
            <a href="https://weddingstoryatelier.etsy.com/de/listing/4504836678/personalisierte-dankeskarte-hochzeit-mit" class="text-xs tracking-[0.2em] uppercase text-ink-muted hover:text-cognac transition-colors" target="_blank" rel="noopener">
              Im Atelier-Shop bei Etsy ↗
            </a>
          </div>
        </article>
        <article class="group">
          <div class="aspect-[3/4] mb-5 overflow-hidden bg-sand">
            <img
              src="/images/empfangsmappe-flatlay-cover-burgund.png"
              alt="Empfangsmappe Old Money — A3 Halbfalz mit Cover, Welcome Letter, Tagesablauf"
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
          <h3 class="serif text-2xl mb-3">Empfangsmappe</h3>
          <p class="text-sm text-ink-muted leading-relaxed mb-5">
            Hero-Bundle für eure Hotelgäste — vier Panels in einem Guss.
          </p>
          <ul class="text-xs tracking-wide text-ink-muted space-y-1.5 border-t border-sand pt-4">
            <li>· Cover · Welcome · Programm · Auf einen Blick</li>
            <li>· Burgund · Cognac · Forest</li>
            <li>· A3 + Tabloid, druckfertig</li>
          </ul>
          <div class="mt-5 flex flex-col gap-2.5 items-start">
            <a href="/atelier/empfangsmappe-old-money.html" class="text-xs tracking-[0.2em] uppercase border-b border-ink pb-0.5 hover:border-cognac hover:text-cognac transition-colors" target="_blank" rel="noopener">
              Live Preview öffnen
            </a>
            <a href="https://weddingstoryatelier.etsy.com/de/listing/4506458037/willkommensmappe-hochzeit-zum-ausdrucken" class="text-xs tracking-[0.2em] uppercase text-ink-muted hover:text-cognac transition-colors" target="_blank" rel="noopener">
              Im Atelier-Shop bei Etsy ↗
            </a>
          </div>
        </article>
        <article class="group">
          <div class="aspect-[3/4] mb-5 overflow-hidden bg-sand">
            <img
              src="/images/3.jpg"
              alt="Plan B Hinweisschild — Sektempfang in Raum 3, wegen starkem Regen verlegt"
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
          <h3 class="serif text-2xl mb-3">Plan B Hinweisschild</h3>
          <p class="text-sm text-ink-muted leading-relaxed mb-5">
            Wenn am Hochzeitstag etwas kurzfristig ändert.
          </p>
          <ul class="text-xs tracking-wide text-ink-muted space-y-1.5 border-t border-sand pt-4">
            <li>· Headline + Detail in Sekunden</li>
            <li>· Optionaler QR — funktioniert offline</li>
            <li>· A4 + US Letter, druckfertig</li>
          </ul>
          <div class="mt-5 flex flex-col gap-2.5 items-start">
            <a href="/demos/plan-b-hinweisschild" class="text-xs tracking-[0.2em] uppercase border-b border-ink pb-0.5 hover:border-cognac hover:text-cognac transition-colors" target="_blank" rel="noopener">
              Live Preview öffnen
            </a>
            <a href="https://weddingstoryatelier.etsy.com/de/listing/4506484590/plan-b-hochzeitsschild-vorlage-zum" class="text-xs tracking-[0.2em] uppercase text-ink-muted hover:text-cognac transition-colors" target="_blank" rel="noopener">
              Im Atelier-Shop bei Etsy ↗
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Process — Atelier-Workflow als Editorial-Step-Line -->
  <section class="px-8 md:px-16 py-32 border-t border-sand">
    <div class="max-w-5xl mx-auto">
      <p class="text-xs tracking-[0.3em] uppercase text-ink-muted mb-4 text-center">
        Der Atelier-Weg
      </p>
      <h2 class="serif text-4xl md:text-5xl text-center mb-20 max-w-2xl mx-auto leading-tight">
        Von der ersten Vorschau zum druckfertigen Werk.
      </h2>

      <ol class="process-steps">
        <li class="process-step">
          <span class="step-numeral">I</span>
          <h3 class="step-title">Ansehen</h3>
          <p class="step-text">Stöbere durch die Werke wie durch eine Galerie. Kein Konto, kein Klick-Zwang.</p>
        </li>
        <li class="process-step">
          <span class="step-numeral">II</span>
          <h3 class="step-title">Ausprobieren</h3>
          <p class="step-text">Öffne eine Live-Demo im Browser, tippe deine Namen — siehst sofort, wie deine Hochzeit aussehen wird.</p>
        </li>
        <li class="process-step">
          <span class="step-numeral">III</span>
          <h3 class="step-title">Bezahlen</h3>
          <p class="step-text">Wenn dir die Vorschau gefällt, kaufst du die Atelier-Vorlage einmalig — heute im Atelier-Shop bei Etsy.</p>
        </li>
        <li class="process-step">
          <span class="step-numeral">IV</span>
          <h3 class="step-title">Personalisieren</h3>
          <p class="step-text">In deiner gekauften Vorlage trägst du Namen, Daten, Fotos ein. Live, wie in der Demo — nur dass jetzt alles bleibt.</p>
        </li>
        <li class="process-step">
          <span class="step-numeral">V</span>
          <h3 class="step-title">Drucken</h3>
          <p class="step-text">Exportiere als PDF. Probedruck zuerst — zuhause, bei DM oder einer Online-Druckerei.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Geschenke-Hinweis — sanft, atelier-style -->
  <section class="px-8 md:px-16 py-20 text-center bg-cream">
    <p class="text-xs tracking-[0.3em] uppercase text-ink-muted mb-6">
      Auch im Atelier
    </p>
    <p class="serif text-xl md:text-2xl italic max-w-2xl mx-auto leading-relaxed text-ink-muted mb-8">
      Neben den Werken leben im Atelier kostenlose Geschenke — die Empfangstisch-Checkliste, „Geld statt Geschenke", Hochzeits-Bingo und das Mythos-Quiz. Direkt im Browser, sofort als PDF mitnehmen.
    </p>
    <a href="/geschenke" class="inline-block text-xs tracking-[0.2em] uppercase border-b border-ink pb-1 hover:border-cognac hover:text-cognac transition-colors">
      Geschenke ansehen →
    </a>
  </section>

  <!-- Atelier-Siegel — das Logo bekommt seine Bühne -->
  <section class="px-8 md:px-16 py-32 text-center">
    <img
      src="/logo.jpg"
      alt="Wedding Story Atelier — Monogramm"
      width="220"
      height="220"
      class="mx-auto rounded-full shadow-sm"
    />
    <p class="serif text-2xl mt-10 text-ink-muted italic">
      Aus dem Atelier
    </p>
    <p class="text-sm text-ink-muted mt-3 max-w-md mx-auto leading-relaxed">
      Jedes Werk entsteht hier zuerst auf Papier — Probedruck, Korrektur, Probedruck.
    </p>
  </section>

  <!-- Footer, minimal -->
  <footer class="px-8 md:px-16 py-12 text-center border-t border-sand">
    <p class="serif text-xl mb-3">Wedding Story Atelier</p>
    <p class="text-xs tracking-[0.2em] uppercase text-ink-muted">
      <a href="/impressum" class="hover:text-ink transition-colors">Impressum</a>
      <span class="mx-3">·</span>
      <a href="/datenschutz" class="hover:text-ink transition-colors">Datenschutz</a>
      <span class="mx-3">·</span>
      <a href="/kontakt" class="hover:text-ink transition-colors">Kontakt</a>
    </p>
  </footer>
</Layout>

<style>
  .process-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2.5rem;
    position: relative;
  }
  /* Verbindungslinie zwischen den Ziffern */
  .process-steps::before {
    content: '';
    position: absolute;
    top: 1.75rem;
    left: 12%;
    right: 12%;
    height: 1px;
    background: var(--color-sand);
    z-index: 0;
  }
  .process-step {
    position: relative;
    text-align: center;
    z-index: 1;
  }
  .step-numeral {
    display: inline-block;
    width: 3.5rem;
    height: 3.5rem;
    line-height: 3.5rem;
    background: var(--color-paper);
    border: 1px solid var(--color-sand);
    border-radius: 50%;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-cognac);
    margin-bottom: 1.25rem;
    transition: all 0.4s ease;
  }
  .process-step:hover .step-numeral {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }
  .step-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
    color: var(--color-ink);
  }
  .step-text {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 14rem;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .process-steps {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .process-steps::before {
      display: none;
    }
    .process-step {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 1.25rem;
      text-align: left;
      align-items: start;
    }
    .step-numeral {
      margin-bottom: 0;
      width: 2.75rem;
      height: 2.75rem;
      line-height: 2.75rem;
      font-size: 1.15rem;
    }
    .step-text {
      max-width: none;
    }
  }
</style>
