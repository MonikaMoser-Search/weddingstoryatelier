---
import Layout from '../layouts/Layout.astro';

const etsyUrl = 'https://weddingstoryatelier.etsy.com/de/listing/4510587510/goldene-hochzeit-einladung-zum-ausfullen';
const demoUrl = '/atelier/goldene-hochzeit-einladung.html';

const faq = [
  {
    q: 'Bekomme ich gedruckte Karten geschickt?',
    a: 'Nein — du bekommst eine digitale Vorlage zum Selbst-Ausfüllen und Drucken. Nach dem Kauf kommt ein Link ins Atelier samt Passwort, du füllst die Einladung direkt im Browser aus und druckst sie selbst oder im Copyshop. Kein physischer Versand, kein Warten auf die Post.',
  },
  {
    q: 'Geht das wirklich komplett am Handy?',
    a: 'Ja. Ausfüllen, Vorschau und PDF speichern funktionieren direkt am Smartphone — ohne PC, ohne App, ohne Editor-Programm. Ob ihr es selbst in die Hand nehmt oder die Familie mithilft: bequem vom Sofa aus, in Ruhe und ohne Zeitdruck.',
  },
  {
    q: 'Gedruckt und digital verschicken — beides?',
    a: 'Beides aus einem Werk. Die gedruckte Karte (A5 oder 5×7 in) als Erinnerungsstück für die engste Familie, dazu eine digitale Version als Bild (1080×1920) für WhatsApp, iMessage oder die Instagram-Story — ideal für Gäste, die weiter weg wohnen.',
  },
  {
    q: 'Welche Formate und Sprachen sind dabei?',
    a: 'A5 (148 × 210 mm, Deutsch) und 5×7 Zoll (English) für den Druck — beide Sprachen im selben Atelier-Zugang. Heimdruck am eigenen Drucker oder Druckerei und Copyshop. Empfohlen: 200–250 g/m² mattes Papier.',
  },
  {
    q: 'Brauche ich Designkenntnisse?',
    a: 'Nein. Namen, Datum, Ort und Antwort-Bitte in die Felder eintragen — die Karte aktualisiert sich live. Champagne-Gold und das ruhige Atelier-Layout bleiben dabei immer stilsicher, ganz ohne Gestaltungsarbeit.',
  },
  {
    q: 'Was bekomme ich nach dem Kauf?',
    a: 'Sofort nach der Etsy-Bestellung eine PDF-Anleitung mit deinem privaten Atelier-Link und Passwort. Ein Klick — du bist drin. Deine Eingaben bleiben lokal auf deinem Gerät, nichts wird hochgeladen.',
  },
];
---

<Layout
  title="Einladung Goldene Hochzeit zum Ausfüllen — am Handy, Champagne-Gold · Wedding Story Atelier"
  description="Einladung zur Goldenen Hochzeit selbst gestalten: im Browser ausfüllen, am Smartphone, drucken oder digital per WhatsApp senden. Champagne-Gold, A5 + 5×7 in, Deutsch & English. 4,55 €."
>
  <!-- Navigation -->
  <header class="absolute top-0 left-0 right-0 z-10 px-8 py-6 md:px-16">
    <nav class="flex items-center justify-between text-sm tracking-wide">
      <a href="/" class="serif text-xl">Wedding Story Atelier</a>
      <ul class="hidden md:flex gap-10 text-ink-muted">
        <li><a href="/ueber-das-atelier" class="hover:text-ink transition-colors">Über das Atelier</a></li>
        <li><a href="/journal" class="hover:text-ink transition-colors">Journal</a></li>
        <li><a href="/kontakt" class="hover:text-ink transition-colors">Kontakt</a></li>
      </ul>
    </nav>
  </header>

  <!-- Hero — Foto links, Text rechts -->
  <section class="px-6 md:px-16 pt-32 md:pt-40 pb-20">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 md:gap-20 items-center">
      <div class="order-2 md:order-1">
        <img
          src="/images/goldene-hochzeit-hero.webp"
          alt="Einladung zur Goldenen Hochzeit in Champagne-Gold — gedruckte Karte mit Umschlag, Kerze und goldenem Füller"
          loading="eager"
          fetchpriority="high"
          class="w-full"
        />
      </div>
      <div class="order-1 md:order-2 text-center md:text-left">
        <p class="text-sm tracking-[0.3em] uppercase text-ink-muted mb-6">
          Aus dem Atelier · 50 Jahre
        </p>
        <h1 class="serif text-5xl md:text-6xl lg:text-7xl leading-[1.05] mb-8">
          Einladung zur Goldenen Hochzeit —<br />
          <em class="text-[#9C7B1A]">zum Ausfüllen, in Minuten.</em>
        </h1>
        <p class="serif text-lg md:text-xl italic text-ink leading-relaxed mb-10">
          Direkt im Browser ausfüllen — auch komplett am Handy. Champagne-Gold, editorial gestaltet. Drucken für die Familie oder digital per WhatsApp senden. A5 und 5×7 Zoll, Deutsch und English.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 items-center md:items-start text-sm tracking-wider">
          <a
            href="#demo"
            class="bg-ink text-paper px-8 py-4 tracking-[0.2em] uppercase text-xs text-center hover:bg-[#9C7B1A] transition-colors"
          >
            Gleich ausprobieren →
          </a>
          <a
            href={etsyUrl}
            target="_blank"
            rel="noopener"
            data-conversion="goldene-hochzeit-etsy"
            class="border border-ink text-ink px-8 py-4 tracking-[0.2em] uppercase text-xs text-center hover:bg-ink hover:text-paper transition-colors"
          >
            Auf Etsy holen — 4,55 € <span class="line-through opacity-60">6,99 €</span>
          </a>
        </div>
        <p class="text-sm text-ink-muted mt-8 italic">
          Sofortiger Atelier-Zugang nach Kauf · am Handy oder Desktop · Daten bleiben bei euch
        </p>
      </div>
    </div>
  </section>

  <!-- Einmal ausfüllen, zwei Wege -->
  <section class="px-6 md:px-16 py-20 bg-cream border-t border-sand">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 md:gap-16 items-center">
      <div class="order-2 md:order-1">
        <p class="text-sm tracking-[0.3em] uppercase text-ink-muted mb-4">
          Einmal ausfüllen, zwei Wege
        </p>
        <h2 class="serif text-3xl md:text-4xl mb-8 leading-tight">
          Gedruckt für die Familie,<br />
          <em class="text-[#9C7B1A]">digital für alle anderen.</em>
        </h2>
        <div class="space-y-6 text-base text-ink-muted leading-relaxed">
          <div>
            <h3 class="serif text-xl text-ink mb-2">Die gedruckte Karte</h3>
            <p>Für die engste Familie und Nachbarn — ein Erinnerungsstück zum Anfassen. A5 oder 5×7 Zoll, Heimdruck oder Copyshop, auf schönem mattem Papier.</p>
          </div>
          <div>
            <h3 class="serif text-xl text-ink mb-2">Die digitale Einladung</h3>
            <p>Für entfernte Verwandte und Kollegen — als Bild (1080 × 1920) direkt per WhatsApp, iMessage oder Instagram-Story. Kein Porto, in Sekunden verschickt.</p>
          </div>
        </div>
      </div>
      <div class="order-1 md:order-2">
        <img
          src="/images/goldene-hochzeit-zwei-wege.webp"
          alt="Goldene-Hochzeit-Einladung gedruckt neben Smartphone mit derselben digitalen Einladung"
          loading="lazy"
          class="w-full"
        />
      </div>
    </div>
  </section>

  <!-- Drei Versprechen -->
  <section id="format" class="px-8 md:px-16 py-20">
    <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-12">
      <div class="text-center">
        <p class="serif text-4xl text-[#9C7B1A] italic mb-4">I.</p>
        <h3 class="serif text-xl mb-3">In Minuten ausgefüllt</h3>
        <p class="text-base text-ink-muted leading-relaxed">
          Namen, Datum, Ort und Antwort-Bitte eintragen — die Karte aktualisiert sich live. Keine Software, kein Konto, keine Gestaltungsarbeit.
        </p>
      </div>
      <div class="text-center">
        <p class="serif text-4xl text-[#9C7B1A] italic mb-4">II.</p>
        <h3 class="serif text-xl mb-3">Am Handy bedienbar</h3>
        <p class="text-base text-ink-muted leading-relaxed">
          Anders als die meisten Vorlagen läuft dieses Werk komplett am Smartphone — ausfüllen, Vorschau, PDF. Ganz ohne PC, ohne App, ohne Vorkenntnisse.
        </p>
      </div>
      <div class="text-center">
        <p class="serif text-4xl text-[#9C7B1A] italic mb-4">III.</p>
        <h3 class="serif text-xl mb-3">Champagne-Gold, editorial</h3>
        <p class="text-base text-ink-muted leading-relaxed">
          Warmes Champagne-Gold mit leisem Mushroom-Akzent, editoriale Serifen-Typografie. Zweisprachig Deutsch und English. Im Atelier gedruckt und getestet.
        </p>
      </div>
    </div>
  </section>

  <!-- Demo -->
  <section id="demo" class="px-4 md:px-16 py-24 bg-cream border-t border-sand">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sm tracking-[0.3em] uppercase text-ink-muted mb-4">
          Direkt ausprobieren
        </p>
        <h2 class="serif text-4xl md:text-5xl mb-6">
          So füllt ihr eure Einladung aus.
        </h2>
        <p class="serif text-lg italic text-ink-muted max-w-2xl mx-auto leading-relaxed">
          Demo läuft mit Beispiel-Angaben. Eigene Namen, Datum und Ort eintragen, Sprache wechseln — die Karte reagiert live. Drucken und PDF-Speichern sind hier gesperrt; die Vollversion ist das Werk im Etsy-Shop.
        </p>
      </div>

      <!-- Desktop: Live-Demo per iframe -->
      <div class="hidden md:block border border-sand bg-paper shadow-[0_24px_64px_rgba(0,0,0,0.08)]">
        <iframe
          src={demoUrl}
          title="Goldene Hochzeit Einladung — Live-Demo"
          loading="lazy"
          class="w-full"
          style="height: 1150px; border: 0; display: block;"
        ></iframe>
      </div>

      <!-- Mobile: Demo ist mobil bedienbar — im neuen Tab öffnen -->
      <div class="md:hidden border border-sand bg-paper">
        <img
          src="/images/goldene-hochzeit-zwei-wege.webp"
          alt="Goldene-Hochzeit-Einladung gedruckt und auf dem Smartphone"
          loading="lazy"
          class="w-full"
        />
        <div class="px-6 py-8 text-center">
          <p class="text-sm tracking-[0.3em] uppercase text-[#7B6115] mb-3">Demo am Handy</p>
          <p class="serif italic text-lg leading-relaxed text-ink-muted mb-6">
            Diese Vorlage funktioniert direkt am Smartphone — tippt euch unten durch die Karte und probiert das Ausfüllen selbst aus.
          </p>
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener"
            class="inline-block bg-ink text-paper px-8 py-4 tracking-[0.2em] uppercase text-xs hover:bg-[#9C7B1A] transition-colors"
          >
            Demo am Handy öffnen →
          </a>
        </div>
      </div>

      <p class="text-sm text-ink-muted text-center mt-6 italic">
        Vorschau ohne Druck und PDF · die ausfüllbare Vollversion gibt es im Etsy-Werk
      </p>

      <!-- Frühstarter-Vorteil — gratis Willkommensmappe mit 20-%-Code, lädt die anniversary-Variante -->
      <div class="max-w-xl mx-auto mt-14 border border-[#C9A84C] bg-[#C9A84C]/[0.08] px-8 py-9 text-center">
        <p class="serif italic text-xs tracking-[0.18em] uppercase text-[#9C7B1A] mb-3">
          Frühstarter-Vorteil · für die ersten Paare
        </p>
        <p class="serif text-3xl text-[#9C7B1A] mb-3">20 % Atelier-Rabatt</p>
        <p class="serif text-base text-ink-muted leading-relaxed mb-7 max-w-md mx-auto">
          Wir sind ein junges Atelier — sichert euch euren Willkommens-Code für eure erste Bestellung. Ihr bekommt ihn in einer kleinen Willkommensmappe als PDF.
        </p>
        <button
          id="frueh-btn"
          type="button"
          class="inline-block bg-ink text-paper px-8 py-4 tracking-[0.2em] uppercase text-xs hover:bg-[#9C7B1A] transition-colors disabled:opacity-60 disabled:cursor-default"
        >
          Rabattcode sichern →
        </button>
        <p class="text-xs text-ink-muted mt-4 italic">Gratis PDF · der Browser fragt kurz nach dem Download</p>
      </div>

      <div class="text-center mt-12">
        <a
          href={etsyUrl}
          target="_blank"
          rel="noopener"
          data-conversion="goldene-hochzeit-etsy"
          class="inline-block bg-ink text-paper px-8 py-4 tracking-[0.2em] uppercase text-xs hover:bg-[#9C7B1A] transition-colors"
        >
          Vollversion auf Etsy holen →
        </a>
      </div>
    </div>
  </section>

  <!-- So funktioniert es -->
  <section class="px-8 md:px-16 py-24 border-t border-sand">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm tracking-[0.3em] uppercase text-ink-muted text-center mb-4">
        So funktioniert es
      </p>
      <h2 class="serif text-4xl md:text-5xl text-center mb-16">
        In vier Schritten zur Einladung.
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10">
        <div>
          <p class="text-sm tracking-[0.2em] uppercase text-[#7B6115] mb-3">Schritt eins</p>
          <h3 class="serif text-xl mb-3">Link aus Etsy öffnen</h3>
          <p class="text-base text-ink-muted leading-relaxed">
            Direkt nach dem Kauf liegt ein privater Atelier-Link mit Passwort in der Etsy-Nachricht. Am Handy, Tablet oder Laptop öffnen.
          </p>
        </div>
        <div>
          <p class="text-sm tracking-[0.2em] uppercase text-[#7B6115] mb-3">Schritt zwei</p>
          <h3 class="serif text-xl mb-3">Sprache & Felder ausfüllen</h3>
          <p class="text-base text-ink-muted leading-relaxed">
            Deutsch oder English wählen, dann Namen, Datum, Ort und Antwort-Bitte eintragen.
          </p>
        </div>
        <div>
          <p class="text-sm tracking-[0.2em] uppercase text-[#7B6115] mb-3">Schritt drei</p>
          <h3 class="serif text-xl mb-3">Live-Vorschau prüfen</h3>
          <p class="text-base text-ink-muted leading-relaxed">
            Die Karte aktualisiert sich beim Tippen. Alles sitzt? Weiter zum letzten Schritt.
          </p>
        </div>
        <div>
          <p class="text-sm tracking-[0.2em] uppercase text-[#7B6115] mb-3">Schritt vier</p>
          <h3 class="serif text-xl mb-3">Drucken oder digital senden</h3>
          <p class="text-base text-ink-muted leading-relaxed">
            „Drucken / PDF" für die gedruckte Karte oder die digitale Einladung speichern — fertig zum Verschicken.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Was im Werk steckt — Foto rechts -->
  <section id="werk" class="px-8 md:px-16 py-24 bg-cream border-t border-sand">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 md:gap-16 items-center">
      <div>
        <p class="text-sm tracking-[0.3em] uppercase text-ink-muted mb-4">
          Im Werk enthalten
        </p>
        <h2 class="serif text-3xl md:text-4xl mb-8 leading-tight">
          Ein Werk — und die<br />
          Einladung steht.
        </h2>
        <ul class="space-y-4 text-base text-ink-muted leading-relaxed">
          <li class="flex gap-3"><span class="text-[#7B6115]">·</span> Atelier-Zugang als Browser-Tool — kein Download, kein Konto</li>
          <li class="flex gap-3"><span class="text-[#7B6115]">·</span> Gedruckte Einladung als PDF — A5 (Deutsch) und 5×7 Zoll (English)</li>
          <li class="flex gap-3"><span class="text-[#7B6115]">·</span> Digitale Einladung als Bild (1080 × 1920) für WhatsApp und Instagram-Story</li>
          <li class="flex gap-3"><span class="text-[#7B6115]">·</span> Beide Sprachen im selben Zugang — Deutsch und English</li>
          <li class="flex gap-3"><span class="text-[#7B6115]">·</span> Komplett am Smartphone bedienbar — ausfüllen, Vorschau, PDF</li>
          <li class="flex gap-3"><span class="text-[#7B6115]">·</span> Champagne-Gold mit Mushroom-Akzent, editoriale Typografie</li>
          <li class="flex gap-3"><span class="text-[#7B6115]">·</span> Heimdruck und Copyshop, mit Druckempfehlung in der Anleitung</li>
          <li class="flex gap-3"><span class="text-[#7B6115]">·</span> Unbegrenzte Bearbeitung — Daten bleiben lokal</li>
        </ul>
        <p class="text-base text-ink-muted leading-relaxed mt-8 italic border-l-2 border-[#9C7B1A] pl-4">
          Für den vollen Auftritt: Im Atelier gibt es parallel das Anniversary Golden Kit — Einladung, Tagesablauf und Platzkarten als aufeinander abgestimmtes Set.
        </p>
      </div>
      <div>
        <img
          src="/images/goldene-hochzeit-werk.webp"
          alt="Digitale Goldene-Hochzeit-Einladung auf dem Smartphone — am Handy ausgefüllt und per WhatsApp geteilt"
          loading="lazy"
          class="w-full"
        />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="px-8 md:px-16 py-24 border-t border-sand">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm tracking-[0.3em] uppercase text-ink-muted text-center mb-4">
        Häufige Fragen
      </p>
      <h2 class="serif text-4xl md:text-5xl text-center mb-16">
        Was Familien oft fragen.
      </h2>
      <div class="space-y-8">
        {faq.map((item) => (
          <details class="group border-b border-sand pb-6">
            <summary class="cursor-pointer flex justify-between items-start gap-6 list-none py-2">
              <h3 class="serif text-xl group-open:text-[#7B6115] transition-colors">{item.q}</h3>
              <span class="serif text-2xl text-[#9C7B1A] mt-[-4px] group-open:rotate-45 transition-transform inline-block">+</span>
            </summary>
            <p class="text-base text-ink-muted leading-relaxed mt-4 max-w-2xl">{item.a}</p>
          </details>
        ))}
      </div>

      <p class="text-base text-ink-muted text-center mt-12 italic">
        Noch unsicher, was auf die Karte gehört oder wie ihr sie formuliert?
        <a href="/einladung-goldene-hochzeit-gestalten" class="not-italic border-b border-ink-muted pb-0.5 hover:text-[#7B6115] hover:border-[#7B6115] transition-colors">
          Checkliste &amp; Beispiel-Texte ansehen →
        </a>
      </p>
    </div>
  </section>

  <!-- Wie drucke ich das? — Druck-Beruhigung für die ältere Zielgruppe (Sitelink-Ziel #drucken) -->
  <section id="drucken" class="px-8 md:px-16 py-24 bg-cream border-t border-sand">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm tracking-[0.3em] uppercase text-ink-muted text-center mb-4">
        Wie drucke ich das?
      </p>
      <h2 class="serif text-4xl md:text-5xl text-center mb-6">
        Drucken ist einfacher, als ihr denkt.
      </h2>
      <p class="serif text-lg italic text-ink-muted text-center max-w-2xl mx-auto mb-16 leading-relaxed">
        Drei Wege — sucht euch einfach den aus, der zu euch passt.
      </p>
      <div class="grid md:grid-cols-3 gap-12">
        <div>
          <p class="serif text-4xl text-[#9C7B1A] italic mb-4">I.</p>
          <h3 class="serif text-xl mb-3">dm, Rossmann oder Copyshop</h3>
          <p class="text-base text-ink-muted leading-relaxed">
            Bei dm oder Rossmann gibt es Foto-Terminals zum Selbermachen: einfach das Handy anstecken (eure Datei ist ja schon drauf), der Bildschirm führt Schritt für Schritt durch — und die netten Mitarbeiterinnen helfen gern, wenn man mag. Im Copyshop ums Eck druckt man es direkt für euch, oft sogar mit Probedruck.
          </p>
        </div>
        <div>
          <p class="serif text-4xl text-[#9C7B1A] italic mb-4">II.</p>
          <h3 class="serif text-xl mb-3">Lieber selbst drucken</h3>
          <p class="text-base text-ink-muted leading-relaxed">
            Mit festerem Fotopapier (ca. 250 g) und der Foto-Einstellung des Druckers gelingt die Karte auch zu Hause wunderschön.
          </p>
        </div>
        <div>
          <p class="serif text-4xl text-[#9C7B1A] italic mb-4">III.</p>
          <h3 class="serif text-xl mb-3">Lieber ganz ohne Papier</h3>
          <p class="text-base text-ink-muted leading-relaxed">
            Müsst ihr gar nicht drucken: Verschickt die Einladung als Bild direkt per WhatsApp, iMessage oder Instagram-Story. In Sekunden bei allen — ohne Drucker, ohne Porto.
          </p>
        </div>
      </div>
      <p class="text-base text-ink-muted leading-relaxed mt-16 italic border-l-2 border-[#9C7B1A] pl-4 max-w-2xl mx-auto">
        Ein Tipp für alle Wege: im Druckdialog immer „Foto" bzw. beste Qualität wählen — sonst kann das Champagne-Gold ins Gelbliche kippen. Eine ausführliche Druckanleitung mit genauen Papier-Empfehlungen liegt jeder Bestellung bei.
      </p>
    </div>
  </section>

  <!-- Schluss-CTA -->
  <section class="px-8 md:px-16 py-32 text-center border-t border-sand">
    <p class="text-sm tracking-[0.3em] uppercase text-ink-muted mb-6">
      Bereit für eure Einladung
    </p>
    <h2 class="serif text-4xl md:text-6xl mb-10 max-w-3xl mx-auto leading-tight">
      50 Jahre — und alle<br />
      <em class="text-[#9C7B1A]">sind dabei.</em>
    </h2>
    <a
      href={etsyUrl}
      target="_blank"
      rel="noopener"
      data-conversion="goldene-hochzeit-etsy"
      class="inline-block bg-ink text-paper px-10 py-5 tracking-[0.2em] uppercase text-xs hover:bg-[#9C7B1A] transition-colors"
    >
      Einladung auf Etsy holen — 4,55 € →
    </a>
    <p class="text-sm text-ink-muted mt-8 italic max-w-md mx-auto">
      Sofortiger Atelier-Zugang · am Handy oder Desktop · gedruckt und digital · beliebig oft bearbeiten
    </p>
  </section>

  <footer class="px-8 md:px-16 py-12 text-center border-t border-sand bg-cream">
    <p class="serif text-xl mb-3">Wedding Story Atelier</p>
    <p class="text-sm tracking-[0.2em] uppercase text-ink-muted">
      <a href="/impressum" class="hover:text-ink transition-colors">Impressum</a>
      <span class="mx-3">·</span>
      <a href="/datenschutz" class="hover:text-ink transition-colors">Datenschutz</a>
      <span class="mx-3">·</span>
      <a href="/kontakt" class="hover:text-ink transition-colors">Kontakt</a>
    </p>
  </footer>

  <!-- Mobiler Sticky-CTA — hält Demo + Kauf auf der langen Seite immer erreichbar (nur Handy) -->
  <div class="md:hidden fixed bottom-0 left-0 right-0 z-30 bg-paper border-t border-sand px-4 py-3 flex gap-3 items-center shadow-[0_-8px_24px_rgba(0,0,0,0.06)]">
    <a
      href="#demo"
      class="flex-1 text-center border border-ink text-ink py-4 tracking-[0.15em] uppercase text-xs hover:bg-ink hover:text-paper transition-colors"
    >
      Demo
    </a>
    <a
      href={etsyUrl}
      target="_blank"
      rel="noopener"
      data-conversion="goldene-hochzeit-etsy"
      class="flex-1 text-center bg-ink text-paper py-4 tracking-[0.15em] uppercase text-xs hover:bg-[#7B6115] transition-colors"
    >
      Auf Etsy — 4,55 €
    </a>
  </div>
  <!-- Spacer, damit der Sticky-CTA am Seitenende nichts verdeckt -->
  <div class="md:hidden h-20" aria-hidden="true"></div>

  <!-- FAQ Schema für Rich Results -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a }
    }))
  })} />

  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Goldene Hochzeit Einladung zum Ausfüllen — Champagne-Gold",
    "description": "Einladung zur Goldenen Hochzeit zum Selbst-Ausfüllen im Browser, komplett am Smartphone. Champagne-Gold, editorial. Gedruckt (A5 und 5×7 in) oder digital per Messenger. Deutsch und English im selben Zugang.",
    "image": "https://weddingstoryatelier.de/images/goldene-hochzeit-hero.webp",
    "brand": { "@type": "Brand", "name": "Wedding Story Atelier" },
    "offers": {
      "@type": "Offer",
      "url": etsyUrl,
      "priceCurrency": "EUR",
      "price": "4.55",
      "availability": "https://schema.org/InStock"
    }
  })} />

  <!-- Frühstarter-Rabatt: lädt die Export-Libs + Mappe erst beim Klick (hält die Landing leicht) -->
  <script is:inline>
    (function () {
      var btn = document.getElementById('frueh-btn');
      if (!btn) return;
      var label = btn.textContent;
      var ready = null;

      function loadScript(src) {
        return new Promise(function (res, rej) {
          if (document.querySelector('script[data-frueh="' + src + '"]')) { res(); return; }
          var s = document.createElement('script');
          s.src = src; s.async = false; s.setAttribute('data-frueh', src);
          s.onload = res;
          s.onerror = function () { rej(new Error('Konnte ' + src + ' nicht laden')); };
          document.head.appendChild(s);
        });
      }

      function ensureLibs() {
        if (ready) return ready;
        ready = loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js')
          .then(function () { return loadScript('https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js'); })
          .then(function () { return loadScript('/geschenke/willkommensmappe.js?v=20260611d'); });
        return ready;
      }

      btn.addEventListener('click', function () {
        btn.disabled = true; btn.textContent = 'PDF wird erstellt …';
        if (typeof window.clarity === 'function') window.clarity('event', 'frueh_mappe_klick');
        ensureLibs()
          .then(function () { return window.downloadWillkommensmappe('anniversary'); })
          .then(function () { btn.disabled = false; btn.textContent = label; })
          .catch(function () {
            btn.disabled = false; btn.textContent = label;
            alert('Der Download hat nicht geklappt — bitte versucht es gleich noch einmal.');
          });
      });
    })();
  </script>

  <!-- Google Ads Conversion Trigger — feuert beim Etsy-Outbound-Klick, sofern Cookie-Consent granted -->
  <!-- Conversion-Aktion "Etsy-Klick Goldene Hochzeit" (angelegt 2026-06-10) -->
  <script is:inline>
    (function () {
      const SEND_TO = 'AW-18181056795/HC-5CMnQorwcEJvSs91D';

      function clarityEvent(name) {
        if (typeof window.clarity === 'function') window.clarity('event', name);
      }

      function fireConversion() {
        clarityEvent('etsy_klick');
        if (typeof window.gtag !== 'function') return;
        window.gtag('event', 'conversion', {
          send_to: SEND_TO,
          value: 4.55,
          currency: 'EUR',
        });
      }

      function attach() {
        document.querySelectorAll('a[data-conversion="goldene-hochzeit-etsy"]').forEach(function (el) {
          if (el.dataset.wsaWired === '1') return;
          el.dataset.wsaWired = '1';
          el.addEventListener('click', fireConversion);
        });
        document.querySelectorAll('a[href="#demo"], a[href$="goldene-hochzeit-einladung.html"]').forEach(function (el) {
          if (el.dataset.wsaDemoWired === '1') return;
          el.dataset.wsaDemoWired = '1';
          el.addEventListener('click', function () { clarityEvent('demo_geoeffnet'); });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', attach);
      } else {
        attach();
      }
      window.addEventListener('wsa:ads-ready', attach);
    })();
  </script>
</Layout>
